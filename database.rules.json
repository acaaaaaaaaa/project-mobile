{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "userRooms": {
      "$uid": {
        ".read": true,
        ".write": true,
        ".indexOn": ["scheduledStart", "status", "role"]
      }
    },
    "rooms": {
      ".read": true,
      ".write": true,
      "$roomId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["hostUid", "code", "createdAt"]
      }
    },
    "roomCodes": {
      ".read": true,
      ".write": true,
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "roomMembers": {
      ".read": true,
      ".write": true,
      "$roomId": {
        ".read": true,
        ".write": true,
        "$uid": {
          ".read": true,
          ".write": true
        }
      }
    },
    "roomEvents": {
      ".read": true,
      ".write": true,
      "$roomId": {
        ".read": true,
        ".write": true,
        "$eventId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "userSessions": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": true,
        ".indexOn": ["completedAt"]
      }
    },
    "session_logs": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "userActiveRoom": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "userCalendarIntegrations": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "notifications": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    }
  }
}
